# Copy to .env.local and fill in. Never commit real keys.

# --- Clerk ---
# Fastest local path (no account): npx clerk@latest init --accountless -y
# Or paste from https://dashboard.clerk.com/~/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Frontend API URL from Clerk → Convex integration (also encoded in pk_test_*)
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Convex (filled by `npx convex dev`) ---
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_HTTP_URL=https://your-deployment.convex.site

# --- Shared HMAC secret (Convex + n8n) ---
# openssl rand -hex 32
N8N_WEBHOOK_SECRET=replace-with-long-random-secret
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request
